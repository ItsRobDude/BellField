[Unit]
Description=BellField relay database backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=rob
Group=rob
SupplementaryGroups=docker
EnvironmentFile=/etc/bellfield/relay-backup.env
ExecStart=/usr/bin/env bash -lc '"$BELLFIELD_RELAY_DIR/backup-relay-db.sh" "$BELLFIELD_RELAY_BACKUP_TARGET"'
