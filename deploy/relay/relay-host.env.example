# BellField relay host environment. Copy to relay-host.env beside compose.yaml
# and fill in every CHANGE_ME. relay-host.env is the only secrets file on the
# relay box; never commit it.

NODE_ENV=production
BELLFIELD_RELAY_PORT=3201

# Database (relay-postgres service). Keep the password in both lines in sync.
RELAY_DB_PASSWORD=CHANGE_ME
BELLFIELD_RELAY_DATABASE_URL=postgresql://relay:CHANGE_ME@relay-postgres:5432/bellfield_relay

# The only provider credential in the whole product: the dedicated BellField
# Resend account's API key. Lives here and nowhere else.
BELLFIELD_RELAY_RESEND_API_KEY=CHANGE_ME

# Relay-owned sender addresses. Customer installs select the sender by message
# type; they never supply arbitrary From addresses.
BELLFIELD_RELAY_ESTIMATE_FROM_ADDRESS=estimates@bellfield.app
BELLFIELD_RELAY_INVOICE_FROM_ADDRESS=billing@bellfield.app
# Billing sender fronting customer payment/refund receipt emails.
BELLFIELD_RELAY_RECEIPT_FROM_ADDRESS=billing@bellfield.app

# Signing secret from the Resend webhook (create the webhook pointing at
# https://relay.bellfield.app/webhooks/resend once the tunnel is live).
BELLFIELD_RELAY_WEBHOOK_SIGNING_SECRET=CHANGE_ME

# Stripe Connect payment links and BellField-branded online payments setup.
# These are BellField platform credentials and stay on the relay host only;
# customer installs never receive Stripe keys.
BELLFIELD_RELAY_STRIPE_SECRET_KEY=CHANGE_ME
BELLFIELD_RELAY_STRIPE_WEBHOOK_SECRET=CHANGE_ME

# Cloudflare Tunnel token (remotely-managed tunnel; the only Cloudflare
# credential on the box).
TUNNEL_TOKEN=CHANGE_ME

# Optional knobs (defaults shown; uncomment to override).
# BELLFIELD_RELAY_DEFAULT_MONTHLY_QUOTA=1000
# BELLFIELD_RELAY_REBIND_FLAP_THRESHOLD=5
# BELLFIELD_RELAY_REBIND_FLAP_WINDOW_MINUTES=60
# BELLFIELD_RELAY_PUBLIC_BASE_URL=https://relay.bellfield.app

# Fixed BellField payments policy: 100 basis points (1%) application fee on
# every online payment made through BellField, including invoice and deposit
# Checkout links. The relay rejects other values; leave unset to use 100.
BELLFIELD_RELAY_PAYMENTS_PLATFORM_FEE_BASIS_POINTS=100
