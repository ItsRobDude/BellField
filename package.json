{
  "name": "bellfield",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "24.x",
    "pnpm": "10.13.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.31.0",
    "@typescript-eslint/parser": "8.31.0",
    "eslint": "9.25.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3"
  },
  "scripts": {
    "dev:office-web": "pnpm --filter @bellfield/office-web dev",
    "dev:field-mobile": "pnpm --filter @bellfield/field-mobile dev",
    "dev:api": "pnpm --filter @bellfield/api dev",
    "dev:worker": "pnpm --filter @bellfield/worker dev",
    "dev:postgres": "node tools/start-local-postgres.mjs",
    "dev:postgres:stop": "node tools/stop-local-postgres.mjs",
    "dev:postgres:docker": "docker compose up -d postgres",
    "dev:postgres:docker:stop": "docker compose stop postgres",
    "dev:postgres:docker:down": "docker compose down",
    "dev:postgres:docker:logs": "docker compose logs -f postgres",
    "dev:migrate": "node tools/run-local-migrations.mjs",
    "start:office-web": "pnpm --filter @bellfield/office-web start",
    "start:field-mobile": "pnpm --filter @bellfield/field-mobile start",
    "start:api": "pnpm --filter @bellfield/api start",
    "start:worker": "pnpm --filter @bellfield/worker start",
    "build": "pnpm -r --if-present build",
    "check:architecture": "node tools/check-architecture.mjs",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test"
  }
}
