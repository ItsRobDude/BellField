NODE_ENV=production
BOOTSTRAP_SEED_DATA=false

# API service
BELLFIELD_API_PORT=3001
BELLFIELD_OFFICE_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://bellfield:CHANGE_ME@127.0.0.1:5432/bellfield

# Office web service
BELLFIELD_OFFICE_WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Server-owned storage and secrets
BELLFIELD_MEDIA_ROOT=C:\BellField\data\media
BELLFIELD_MEDIA_TOKEN_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
BELLFIELD_LICENSE_REQUIRED=true
BELLFIELD_LICENSE_PATH=C:\BellField\data\license\bellfield-license.json

# Backup and restore
BELLFIELD_BACKUP_ENABLED=true
BELLFIELD_BACKUP_ROOT=C:\BellField\data\backups
BELLFIELD_BACKUP_INTERVAL_MINUTES=1440
BELLFIELD_BACKUP_RETENTION_COUNT=7
BELLFIELD_BACKUP_STALE_AFTER_HOURS=36

# BellField delivery relay client (issued by BellField with the license).
# Base URL + token enable the relay. The server instance id is generated during
# install and may be present while base URL/token stay empty; in that state
# estimate email reports not configured and everything else runs normally.
# No provider API key ever exists on this server.
BELLFIELD_RELAY_BASE_URL=
BELLFIELD_RELAY_TOKEN=
BELLFIELD_RELAY_SERVER_INSTANCE_ID=GENERATED_SERVER_INSTANCE_ID
BELLFIELD_PAYMENT_EVENTS_INTERVAL_SECONDS=60
