# BellField root environment conventions
#
# This file documents shared environment variable names used by BellField apps/scripts.
# Do not place secrets in this file. Copy values into app-specific `.env` files or your shell.

# Runtime mode used by API and worker.
# Supported values: development | test | production
NODE_ENV=development

# HTTP listen port for apps/api.
PORT=3001

# PostgreSQL connection string used by API migration scripts.
# Example local value:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bellfield
