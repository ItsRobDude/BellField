# BellField root environment conventions
#
# This file documents shared environment variable names used by BellField apps/scripts.
# Do not place secrets in this file. Copy values into app-specific `.env` files or your shell.

# Runtime mode used by API and worker.
# Supported values: development | test | production
NODE_ENV=development

# HTTP listen port for apps/api.
PORT=3001

# PostgreSQL connection string used by API runtime and migration scripts.
# Required in production: the API refuses to start if it is unset there.
# Development and test fall back to this local default when omitted.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bellfield

# Development-only bootstrap seed toggle for API startup.
# Defaults to false when omitted. Dev seed data is opt-in.
# Production startup refuses BOOTSTRAP_SEED_DATA=true.
BOOTSTRAP_SEED_DATA=true

# Comma-separated office-web origins allowed to call the API in production.
# Required in production. Development and test are permissive when omitted.
BELLFIELD_OFFICE_ORIGINS=http://localhost:3000

# Media blob storage for photos, videos, and document attachments.
# In production, BELLFIELD_MEDIA_ROOT and BELLFIELD_MEDIA_TOKEN_SECRET are required.
# Use at least 32 random characters for the production token secret; do not ship this sample value.
# In dev/test, the API falls back to an OS temp media folder and a weak dev-only secret if omitted.
BELLFIELD_MEDIA_ROOT=C:\BellFieldData\media
BELLFIELD_MEDIA_TOKEN_SECRET=replace-with-a-long-random-secret
BELLFIELD_MEDIA_MAX_BYTES=52428800
BELLFIELD_MEDIA_TOKEN_TTL_SECONDS=300

# Local backup defaults. Production/server installs should use the unified
# bellfield-server.env file and an app-owned local or validated network path.
BELLFIELD_BACKUP_ENABLED=true
BELLFIELD_BACKUP_ROOT=C:\BellFieldData\backups
BELLFIELD_BACKUP_INTERVAL_MINUTES=1440
BELLFIELD_BACKUP_RETENTION_COUNT=7
BELLFIELD_BACKUP_STALE_AFTER_HOURS=36

# Signed offline license file. Development and tests run unlicensed unless this is explicit.
BELLFIELD_LICENSE_REQUIRED=false
BELLFIELD_LICENSE_PATH=

# BellField delivery relay client (estimate email). Issued by BellField with
# the license; all three set together or all empty. Installs never hold
# provider API keys — the relay does (docs/delivery-relay-plan.md §1).
# For local dev, run the relay with `pnpm dev:relay` and point at it.
BELLFIELD_RELAY_BASE_URL=http://localhost:3201
BELLFIELD_RELAY_TOKEN=replace-with-issued-relay-token
BELLFIELD_RELAY_SERVER_INSTANCE_ID=replace-with-stable-uuid

# Client app API base URLs live in:
# - apps/office-web/.env.example (`NEXT_PUBLIC_API_BASE_URL`)
# - apps/field-mobile/.env.example (`EXPO_PUBLIC_API_BASE_URL`)
