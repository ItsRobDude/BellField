# BellField root environment conventions
#
# This file documents shared environment variable names used by BellField apps/scripts.
# Do not place secrets in this file. Copy values into app-specific `.env` files or your shell.

# Runtime mode used by API and worker.
# Supported values: development | test | production
NODE_ENV=development

# HTTP listen port for apps/api.
PORT=3001

# PostgreSQL connection string used by API runtime and migration scripts.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bellfield

# Development-only bootstrap seed toggle for API startup.
# Defaults to true outside production when omitted.
BOOTSTRAP_SEED_DATA=true

# Media blob storage for photos, videos, and document attachments.
# In production, BELLFIELD_MEDIA_ROOT and BELLFIELD_MEDIA_TOKEN_SECRET are required.
# In dev/test, the API falls back to an OS temp media folder and a weak dev-only secret if omitted.
BELLFIELD_MEDIA_ROOT=C:\BellFieldData\media
BELLFIELD_MEDIA_TOKEN_SECRET=replace-with-a-long-random-secret
BELLFIELD_MEDIA_MAX_BYTES=52428800
BELLFIELD_MEDIA_TOKEN_TTL_SECONDS=300

# Client app API base URLs live in:
# - apps/office-web/.env.example (`NEXT_PUBLIC_API_BASE_URL`)
# - apps/field-mobile/.env.example (`EXPO_PUBLIC_API_BASE_URL`)
