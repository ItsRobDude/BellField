{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The repo base config targets NodeNext, but @bellfield/api is a CommonJS
    // NestJS app that require()s this package's emitted output at runtime (unlike
    // @bellfield/contracts, which is type-only and erased). Emit CommonJS + node
    // resolution so `nest start` can load dist/index.js without an ESM/require
    // interop seam. The package is intentionally NOT "type": "module".
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    // Safe under ts-jest's per-file transpilation; no behavioral effect on tsc.
    "isolatedModules": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
