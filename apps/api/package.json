{
  "name": "@bellfield/api",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "predev": "corepack pnpm --filter @bellfield/estimating build",
    "dev": "nest start --watch --entryFile apps/api/src/main",
    "prestart": "corepack pnpm --filter @bellfield/estimating build",
    "start": "nest start --entryFile apps/api/src/main",
    "start:prod": "node dist/apps/api/src/main.js",
    "prebuild": "corepack pnpm --filter @bellfield/estimating build",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "pretest": "corepack pnpm --filter @bellfield/estimating build",
    "test": "jest --runInBand",
    "pretypecheck": "corepack pnpm --filter @bellfield/estimating build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migration:create": "node ./scripts/migrations/create.mjs",
    "migration:up": "node ./scripts/migrations/up.mjs",
    "migration:down": "node ./scripts/migrations/down.mjs",
    "migration:up:psql": "node ./scripts/migrations/up.mjs --driver=psql",
    "migration:down:psql": "node ./scripts/migrations/down.mjs --driver=psql",
    "field-smoke:data": "node ./scripts/prepare-field-smoke-data.mjs",
    "identity-admin": "node dist/apps/api/src/cli/identity-admin.js"
  },
  "dependencies": {
    "@bellfield/contracts": "workspace:*",
    "@bellfield/estimating": "workspace:*",
    "@nestjs/common": "11.1.24",
    "@nestjs/core": "11.1.24",
    "@nestjs/platform-express": "11.1.24",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pdfkit": "^0.20.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.24",
    "@types/jest": "30.0.0",
    "@types/node": "22.15.17",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "9.39.4",
    "jest": "30.5.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "typescript": "5.8.3"
  }
}
