{
  "name": "@bellfield/api",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "pnpm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migration:create": "node ./scripts/migrations/create.mjs",
    "migration:up": "node ./scripts/migrations/up.mjs",
    "migration:down": "node ./scripts/migrations/down.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.1.3",
    "@nestjs/core": "11.1.3",
    "@nestjs/platform-express": "11.1.3",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.7",
    "@nestjs/schematics": "11.0.5",
    "@nestjs/testing": "11.1.3",
    "@types/node": "22.15.17",
    "@types/pg": "8.20.0",
    "@typescript-eslint/eslint-plugin": "8.31.0",
    "@typescript-eslint/parser": "8.31.0",
    "eslint": "9.25.0",
    "typescript": "5.8.3"
  }
}
