{
  "name": "@bellfield/api",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "nest start --watch --entryFile apps/api/src/main",
    "start": "nest start --entryFile apps/api/src/main",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migration:create": "node ./scripts/migrations/create.mjs",
    "migration:up": "node ./scripts/migrations/up.mjs",
    "migration:down": "node ./scripts/migrations/down.mjs",
    "migration:up:psql": "node ./scripts/migrations/up.mjs --driver=psql",
    "migration:down:psql": "node ./scripts/migrations/down.mjs --driver=psql",
    "field-smoke:data": "node ./scripts/prepare-field-smoke-data.mjs"
  },
  "dependencies": {
    "@bellfield/contracts": "workspace:*",
    "@bellfield/estimating": "workspace:*",
    "@nestjs/common": "11.1.24",
    "@nestjs/core": "11.1.24",
    "@nestjs/platform-express": "11.1.24",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.24",
    "@types/jest": "30.0.0",
    "@types/node": "22.15.17",
    "@types/pg": "8.20.0",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.31.0",
    "@typescript-eslint/parser": "8.31.0",
    "eslint": "9.25.0",
    "jest": "30.0.5",
    "supertest": "7.1.1",
    "ts-jest": "29.4.0",
    "typescript": "5.8.3"
  }
}
