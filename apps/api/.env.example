# API runtime environment

# Runtime mode for Nest API process.
NODE_ENV=development

# API listen port.
PORT=3001

# Used by API runtime and migration scripts in apps/api/scripts/migrations/*.mjs
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bellfield

# Development bootstrap seed toggle. Defaults to false when omitted.
# Production startup refuses true.
BOOTSTRAP_SEED_DATA=true

# Comma-separated office-web origins allowed to call the API in production.
# Required in production. Development and test are permissive when omitted.
BELLFIELD_OFFICE_ORIGINS=http://localhost:3000

# Absolute session expiry. Defaults are 12 office-web hours and 30 field-mobile days when omitted.
BELLFIELD_OFFICE_SESSION_TTL_HOURS=12
BELLFIELD_FIELD_SESSION_TTL_DAYS=30

# Signed offline license file. Development and tests run unlicensed unless this is explicit.
BELLFIELD_LICENSE_REQUIRED=false
BELLFIELD_LICENSE_PATH=

# BellField delivery relay client (estimate email). Issued by BellField with
# the license; all three set together or all empty. Installs never hold
# provider API keys — the relay does (docs/delivery-relay-plan.md §1).
# For local dev, run the relay with `pnpm dev:relay` and point at it.
BELLFIELD_RELAY_BASE_URL=http://localhost:3201
BELLFIELD_RELAY_TOKEN=replace-with-issued-relay-token
BELLFIELD_RELAY_SERVER_INSTANCE_ID=replace-with-stable-uuid
